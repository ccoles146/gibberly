AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=westeurope
AZURE_WEBPUBSUB_CONNECTION_STRING=Endpoint=https://...

# Azure OpenAI (GPT-4o mini — filler cleaning)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure Cognitive Services Translator (de→en)
AZURE_TRANSLATOR_KEY=your_translator_key_here
AZURE_TRANSLATOR_REGION=westeurope

# STT chunk interval in seconds (default 1.5)
STT_CHUNK_INTERVAL_S=1.5

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Operator console — used by operator/serve.py to generate config.js
# Local dev:  ws://localhost:8000
# Azure:      wss://gibberly-backend.azurewebsites.net
GIBBERLY_BACKEND=ws://localhost:8000
OPERATOR_PORT=9000
